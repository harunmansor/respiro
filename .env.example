# Copy this file to .env and fill in the values.
# Used by both local dev (next dev) and `docker compose up`.

# PostgreSQL connection (matches the docker-compose db service).
# For `docker compose up`, this is overridden to use the "db" host — but it's
# still needed here for local dev against a local/exposed Postgres.
DATABASE_URL="postgresql://freedive:freedive@localhost:5432/freedive?schema=public"

# Secret for signing session JWTs. REQUIRED — `docker compose up` refuses to
# start without it. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# The bundled Docker Compose app is served directly over HTTP, so this must be
# false for login to work via a LAN address such as http://192.168.x.x:3000.
# Change it to true when the app is served through HTTPS.
AUTH_COOKIE_SECURE="false"
